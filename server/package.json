    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "^12.2.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "tesseract.js": "^6.0.1",
